{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":dependencyDashboard"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": { "enabled": false },
  "platformCommit": "enabled",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am on monday"] },
  "kubernetes": { "managerFilePatterns": ["/^infra/cluster/.+\\.yaml$/"] },
  "flux": { "managerFilePatterns": ["/^infra/cluster/.+\\.yaml$/"] },
  "terraform": { "managerFilePatterns": ["/^infra/tofu/.+\\.tf$/"] },
  "pip-compile": { "managerFilePatterns": ["/^infra/ansible/(lint-)?requirements\\.txt$/"] },
  "pip_requirements": { "enabled": false },
  "customManagers": [
    {
      "customType": "regex",
      "description": "TinyGo, cosign, the Flux CLI, kube-bench and OpenTofu, and VictoriaMetrics' utilities, each pinned by release and by its file's digest for each platform in tools/internal/pinned",
      "managerFilePatterns": ["/^tools/internal/pinned/pinned\\.go$/"],
      "matchStrings": ["\\{\"(?<depName>[A-Za-z0-9-]+/[A-Za-z0-9-]+)\", \"[a-z0-9]+-[a-z0-9]+\", \"(?<currentValue>v[0-9.]+)\", \"(?<currentDigest>[0-9a-f]{64})\"\\}"],
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "PostgreSQL's image for the development database, pinned by version and digest in tools/dev",
      "managerFilePatterns": ["/^tools/dev/db\\.go$/"],
      "matchStrings": ["\"(?<depName>postgres):(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "PostgreSQL's image for the cluster's database, pinned by version and digest in its CloudNativePG Cluster",
      "managerFilePatterns": ["/^infra/cluster/apps/keel/database\\.yaml$/"],
      "matchStrings": ["imageName: (?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[0-9.]+-minimal-trixie)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-minimal-trixie$"
    },
    {
      "customType": "regex",
      "description": "The CloudNativePG operator's image, pinned by version and digest in its HelmRelease's values",
      "managerFilePatterns": ["/^infra/cluster/infrastructure/controllers/cloudnative-pg/release\\.yaml$/"],
      "matchStrings": ["tag: (?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "depNameTemplate": "ghcr.io/cloudnative-pg/cloudnative-pg",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "External Secrets' image, pinned by version and digest in its HelmRelease's values",
      "managerFilePatterns": ["/^infra/cluster/infrastructure/controllers/external-secrets/release\\.yaml$/"],
      "matchStrings": ["tag: (?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "depNameTemplate": "ghcr.io/external-secrets/external-secrets",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Flux's controllers' images, pinned by version and digest in infra/cluster/flux-system; they move with Flux's own version",
      "managerFilePatterns": ["/^infra/cluster/flux-system/kustomization\\.yaml$/"],
      "matchStrings": ["- name: (?<depName>ghcr\\.io/fluxcd/[a-z-]+)\\n\\s+newTag: (?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "k3s, pinned by release and by the commit its tag names in infra/k3s/release.yaml: the installer is fetched at the commit",
      "managerFilePatterns": ["/^infra/k3s/release\\.yaml$/"],
      "matchStrings": ["version: (?<currentValue>v[0-9.]+\\+k3s[0-9]+)\\ncommit: (?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "BuildKit's image for the release's builder, pinned by version and digest in the release workflow",
      "managerFilePatterns": ["/^\\.github/workflows/release\\.yaml$/"],
      "matchStrings": ["image=(?<depName>moby/buildkit):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The images the cluster's charts, operators' objects and vendored manifests run, each pinned by version and digest under a line that names it (# renovate: image=…)",
      "managerFilePatterns": ["/^infra/cluster/.+\\.yaml$/"],
      "matchStrings": [
        "# renovate: image=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\s*(?:new)?[tT]ag: (?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
        "# renovate: image=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\s*tag: (?<currentValue>[^@\\s]+)\\n\\s*digest: (?<currentDigest>sha256:[0-9a-f]{64})",
        "# renovate: image=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\s*(?:image|value): [^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "description": "The k3s release the upgrade plan names, which moves with infra/k3s/release.yaml",
      "managerFilePatterns": ["/^infra/cluster/clusters/prod/configs/upgrade-plan\\.yaml$/"],
      "matchStrings": ["  version: (?<currentValue>v[0-9.]+\\+k3s[0-9]+)\\n"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "PostgreSQL moves a major version with the production operator's image; locally and in CI it follows production.",
      "matchDepNames": ["postgres", "ghcr.io/cloudnative-pg/postgresql"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Node follows the LTS line in .nvmrc; a new major is a deliberate change.",
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "k3s follows its stable channel, which takes up a new minor version of Kubernetes some time after it is out; a new minor is a deliberate change.",
      "matchDepNames": ["k3s-io/k3s", "rancher/k3s-upgrade"],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "k3s moves as one: its release and commit, the version the upgrade plan names, and the upgrade image of that release, which a rule of the manifests holds together.",
      "matchDepNames": ["k3s-io/k3s", "rancher/k3s-upgrade"],
      "groupName": "k3s"
    },
    {
      "description": "The CloudNativePG chart, by tag and digest, moves with the operator's image its values pin; the Barman Cloud plugin, its chart and its two images, with them.",
      "matchDepNames": [
        "ghcr.io/cloudnative-pg/charts/cloudnative-pg", "ghcr.io/cloudnative-pg/cloudnative-pg",
        "ghcr.io/cloudnative-pg/charts/plugin-barman-cloud", "ghcr.io/cloudnative-pg/plugin-barman-cloud", "ghcr.io/cloudnative-pg/plugin-barman-cloud-sidecar"
      ],
      "groupName": "CloudNativePG operator"
    },
    {
      "description": "cert-manager's chart moves with the images its values pin, all checked against cert-manager's key before a release (tools/release -verify-keyed).",
      "matchDepNames": ["quay.io/jetstack/charts/cert-manager", "/^quay\\.io/jetstack/cert-manager-/"],
      "groupName": "cert-manager"
    },
    {
      "description": "The monitoring stack moves as one: VictoriaMetrics' charts, the images their values and the logs' objects pin, and vmalert-tool, which tests the rules with the release that evaluates them.",
      "matchDepNames": [
        "/^ghcr\\.io/victoriametrics/helm-charts//", "/^victoriametrics//", "VictoriaMetrics/VictoriaMetrics", "prom/alertmanager", "grafana/grafana",
        "quay.io/kiwigrid/k8s-sidecar", "quay.io/prometheus/node-exporter", "registry.k8s.io/kube-state-metrics/kube-state-metrics", "curlimages/curl"
      ],
      "groupName": "Monitoring stack"
    },
    {
      "description": "Kured and the system-upgrade controller run from their releases' manifests, kept as published (infra/vendor.yaml): a new release is a deliberate change, made with go run ./tools/vendored -pull beside the image.",
      "matchDepNames": ["ghcr.io/kubereboot/kured", "rancher/system-upgrade-controller", "rancher/kubectl"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The vendored manifests are their releases' own and never edited: the images they name are pinned by digest beside them, in each kustomization.",
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["infra/cluster/infrastructure/controllers/kured/kured-*.yaml", "infra/cluster/infrastructure/controllers/system-upgrade/system-upgrade-controller.yaml"],
      "enabled": false
    },
    {
      "description": "External Secrets supports only its newest minor version: its chart, by tag and digest, moves with the image its values pin.",
      "matchDepNames": ["ghcr.io/external-secrets/charts/external-secrets", "ghcr.io/external-secrets/external-secrets"],
      "groupName": "External Secrets"
    },
    {
      "description": "OpenTofu's providers come from OpenTofu's registry, at exact versions; Renovate keeps the lock file's hashes with them.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_provider"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "OpenTofu itself is pinned in tools/internal/pinned; the configuration's required_version is moved by hand with a new minor version, which Renovate would look up as Terraform's.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "description": "Flux moves as one: its manifests, its controllers' images by digest, and its command line.",
      "matchDepNames": ["fluxcd/flux2", "/^ghcr\\.io/fluxcd//"],
      "groupName": "Flux"
    },
    {
      "description": "Flux's manifests are written by flux install and never edited: the images they name are pinned by digest beside them, in kustomization.yaml, and move with Flux.",
      "matchManagers": ["kubernetes"],
      "matchFileNames": ["infra/cluster/flux-system/gotk-components.yaml"],
      "enabled": false
    },
    {
      "description": "The game's own image and manifests are what a release publishes: the manifests name the image with no version, and Flux follows a tag the promote workflow moves.",
      "matchDepNames": ["ghcr.io/daneelvt/keel", "ghcr.io/daneelvt/keel-manifests"],
      "enabled": false
    }
  ]
}
