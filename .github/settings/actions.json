[
  {
    "method": "PUT",
    "path": "actions/permissions",
    "body": { "enabled": true, "allowed_actions": "selected", "sha_pinning_required": true }
  },
  {
    "method": "PUT",
    "path": "actions/permissions/selected-actions",
    "body": {
      "github_owned_allowed": true,
      "verified_allowed": false,
      "patterns_allowed": ["ossf/scorecard-action@*", "zizmorcore/zizmor-action@*"]
    }
  },
  {
    "method": "PUT",
    "path": "actions/permissions/workflow",
    "body": { "default_workflow_permissions": "read", "can_approve_pull_request_reviews": false }
  },
  {
    "method": "PUT",
    "path": "actions/permissions/fork-pr-contributor-approval",
    "body": { "approval_policy": "all_external_contributors" }
  },
  {
    "method": "PUT",
    "path": "actions/permissions/artifact-and-log-retention",
    "body": { "days": 90 }
  },
  {
    "method": "PUT",
    "path": "actions/oidc/customization/sub",
    "body": { "use_default": true, "use_immutable_subject": true }
  }
]
