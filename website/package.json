{
  "name": "keel-website",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.3+sha512.a2f98d4517bbe89bdca7513a88e78f43a1fd66be1730eaea81f69e18d86d46f3f75d29762e8fdaf42d4de7f8d194b2ebb2a09e9bfa268067591e96796baca7d5",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "glyphs": "node worker/build/glyphs.ts",
    "pretest": "npm run glyphs",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "pretypecheck": "npm run glyphs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run glyphs",
    "site": "vite build",
    "build": "vite build && wrangler deploy --dry-run --outdir dist",
    "page": "vite",
    "checks": "playwright test",
    "pictures": "node pictures/take.ts"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  },
  "devDependencies": {
    "@cf-wasm/resvg": "0.4.0",
    "@cloudflare/vitest-plugin": "1.8.4",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "harfbuzzjs": "1.6.4",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.164.0"
  }
}
