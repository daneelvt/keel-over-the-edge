{
  "name": "keel-website",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.1+sha512.6ca0a6151553fc107e60f1186d9c10d57508dcde6de31292a54d4cc4e8e8ef3de25b3281274657442d7115d10df930bb3794ddcb0681cdfd9d317189abf7b63d",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "glyphs": "node worker/build/glyphs.ts",
    "pretest": "npm run glyphs",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "pretypecheck": "npm run glyphs",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run glyphs",
    "site": "vite build",
    "build": "vite build && wrangler deploy --dry-run --outdir dist",
    "page": "vite",
    "checks": "playwright test",
    "pictures": "node pictures/take.ts"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  },
  "devDependencies": {
    "@cf-wasm/resvg": "0.4.0",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "harfbuzzjs": "1.6.4",
    "sharp": "0.35.5",
    "subset-font": "2.9.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
