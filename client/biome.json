{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!src/catalog/*.gen.*",
      "!src/predict/*.gen.*",
      "!src/ocean/testsea"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "security": { "noGlobalEval": "error" },
      "suspicious": { "noConsole": { "level": "error", "options": { "allow": ["warn", "error"] } } }
    }
  },
  "plugins": ["./build/no-html-sinks.grit"],
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  }
}
