{
  "name": "keel-client",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.1+sha512.6ca0a6151553fc107e60f1186d9c10d57508dcde6de31292a54d4cc4e8e8ef3de25b3281274657442d7115d10df930bb3794ddcb0681cdfd9d317189abf7b63d",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "dev": "vite",
    "owner": "vite -c vite.owner.config.ts",
    "build": "vite build && vite build -c vite.owner.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci . ../art",
    "art": "cd .. && node art/boats/jolly-boat/build.ts && node art/sailors/stand-in/build.ts && for k in wooded tropical rocky sandy volcanic; do node art/town/$k/build.ts; done && node art/flora/build.ts"
  },
  "allowScripts": {
    "@bufbuild/buf": false,
    "fsevents": false
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.1",
    "@preact/signals": "2.11.4",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "binaryen": "132.0.0",
    "gltfpack": "1.3.0",
    "json-schema-to-typescript": "16.0.0",
    "preact": "11.1.0",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
