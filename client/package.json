{
  "name": "keel-client",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.3+sha512.a2f98d4517bbe89bdca7513a88e78f43a1fd66be1730eaea81f69e18d86d46f3f75d29762e8fdaf42d4de7f8d194b2ebb2a09e9bfa268067591e96796baca7d5",
  "engines": {
    "node": ">=24.15.0 <27",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "dev": "vite",
    "owner": "vite -c vite.owner.config.ts",
    "build": "vite build && vite build -c vite.owner.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci . ../art ../website",
    "art": "cd .. && node art/boats/jolly-boat/build.ts && node art/boats/keelboat/build.ts && node art/boats/tall-ship/build.ts && node art/boats/skiff/build.ts && node art/boats/beach-cat/build.ts && node art/boats/yacht/build.ts && node art/boats/catamaran/build.ts && for k in wooded tropical rocky sandy volcanic; do node art/town/$k/build.ts; done && node art/flora/build.ts && node art/life/build.ts && node art/committee/build.ts && node art/pendants/build.ts && node art/icon/build.ts",
    "art:sailors": "cd .. && go run ./tools/sailors",
    "sounds": "cd .. && go run ./tools/sounds -encode"
  },
  "allowScripts": {
    "@bufbuild/buf": false,
    "fsevents": false
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@biomejs/biome": "2.6.9",
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protobuf": "2.17.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@playwright/test": "1.65.1",
    "@preact/signals": "2.11.4",
    "@types/node": "26.6.10",
    "@types/three": "0.187.0",
    "binaryen": "132.0.0",
    "gltfpack": "1.3.0",
    "json-schema-to-typescript": "16.0.0",
    "lightningcss": "1.33.0",
    "preact": "11.2.0",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "overrides": {
    "playwright-core": "$@playwright/test"
  }
}
