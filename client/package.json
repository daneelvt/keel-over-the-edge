{
  "name": "keel-client",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "dev": "vite",
    "owner": "vite -c vite.owner.config.ts",
    "build": "vite build && vite build -c vite.owner.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci . ../art",
    "art": "cd .. && node art/boats/jolly-boat/build.ts && node art/sailors/stand-in/build.ts && for k in wooded tropical rocky sandy volcanic; do node art/town/$k/build.ts; done && node art/flora/build.ts"
  },
  "allowScripts": {
    "@bufbuild/buf": false,
    "fsevents": false
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protobuf": "2.16.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@playwright/test": "1.64.0",
    "@preact/signals": "2.11.3",
    "@types/node": "24.19.1",
    "@types/three": "0.186.0",
    "binaryen": "132.0.0",
    "gltfpack": "1.3.0",
    "json-schema-to-typescript": "16.0.0",
    "preact": "11.0.1",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
