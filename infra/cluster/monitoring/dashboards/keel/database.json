            "uid": "VictoriaMetrics"
          },
          "expr": "sum(rate(cnpg_pg_stat_database_blks_hit{namespace=\"keel\", datname=\"keel\"}[$__rate_interval])) / clamp_min(sum(rate(cnpg_pg_stat_database_blks_hit{namespace=\"keel\", datname=\"keel\"}[$__rate_interval])) + sum(rate(cnpg_pg_stat_database_blks_read{namespace=\"keel\", datname=\"keel\"}[$__rate_interval])), 1e-9)",
