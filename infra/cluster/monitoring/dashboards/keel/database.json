    {
      "type": "table",
      "title": "The statements that cost the most",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "Database"
      },
      "description": "pg_stat_statements, read live as the role grafana: by total time since the statistics were last reset. Texts are normalized: no value is in them.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "Database"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT left(regexp_replace(s.query, '\\s+', ' ', 'g'), 160) AS statement, s.calls, round(s.total_exec_time::numeric, 1) AS total_ms, round(s.mean_exec_time::numeric, 3) AS mean_ms, round(s.max_exec_time::numeric, 1) AS max_ms, s.rows, s.shared_blks_read AS blocks_read, s.shared_blks_hit AS blocks_hit, r.rolname AS role FROM pg_stat_statements s JOIN pg_roles r ON r.oid = s.userid JOIN pg_database d ON d.oid = s.dbid WHERE d.datname = 'keel' ORDER BY s.total_exec_time DESC LIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "statement"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 720
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 25,
      "gridPos": {
        "x": 0,
        "y": 55,
        "w": 24,
        "h": 11
      }
    },
