    {
      "type": "table",
      "title": "Their runs",
      "description": "The Jobs kept: two that passed and two that failed, of each.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (namespace, job_name) (kube_job_status_start_time{namespace=~\"keel|keel-restore\", job_name=~\"(keel-db-dump|keel-restore-test)-.+\"}) * 1000",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (namespace, job_name) (kube_job_status_succeeded{namespace=~\"keel|keel-restore\", job_name=~\"(keel-db-dump|keel-restore-test)-.+\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (namespace, job_name) (kube_job_status_failed{namespace=~\"keel|keel-restore\", job_name=~\"(keel-db-dump|keel-restore-test)-.+\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max by (namespace, job_name) (kube_job_status_completion_time{namespace=~\"keel|keel-restore\", job_name=~\"(keel-db-dump|keel-restore-test)-.+\"} - on (namespace, job_name) kube_job_status_start_time)",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "prometheus": true,
              "container": true,
              "service": true
            },
            "renameByName": {
              "Value #A": "started",
              "Value #B": "passed",
              "Value #C": "failed",
              "Value #D": "took",
              "job_name": "job"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "started"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "took"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
