        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(cnpg_pg_stat_archiver_seconds_since_last_archival{namespace=\"keel\"})",
          "legendFormat": "__auto",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
