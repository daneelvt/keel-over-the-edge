{
  "uid": "keel-backups",
  "title": "Backups",
  "description": "Is the world safe off the machine: the WAL archive, the daily base backups, the weekly dump and the weekly restore test.",
  "tags": [
    "keel"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
