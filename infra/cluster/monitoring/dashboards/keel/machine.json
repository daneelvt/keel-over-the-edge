    {
      "type": "timeseries",
      "title": "What grows on it",
      "description": "What the stores say they hold. local-path's volumes are folders of the root filesystem, so the kubelet cannot tell them apart; the journal, the audit logs and the images are not here.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(cnpg_pg_database_size_bytes{namespace=\"keel\", datname=\"keel\"})",
          "legendFormat": "the database",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(cnpg_collector_pg_wal{namespace=\"keel\", value=\"size\"})",
          "legendFormat": "its WAL",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(vm_data_size_bytes{job=~\"vmsingle.*\"})",
          "legendFormat": "metrics",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum(vl_data_size_bytes)",
          "legendFormat": "logs",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
