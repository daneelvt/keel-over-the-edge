{
  "uid": "keel-machine",
  "title": "Machine",
  "description": "The machine itself: its CPU with what the host steals, pressure, memory, disk and network, its clock, its updates and reboots, and every pod against what it asked for.",
  "tags": [
    "keel"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "keel"
      ],
      "asDropdown": false,
      "title": "",
      "includeVars": false,
      "keepTime": true,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU, by mode",
      "description": "steal is time the host gave another machine.",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "sum by (mode) (max by (cpu, mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval]))) / scalar(count(count by (cpu) (node_cpu_seconds_total{mode=\"idle\"})))",
          "legendFormat": "{{mode}}",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Pressure",
      "description": "The share of time processes waited for a resource (the kernel's pressure stall information).",
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(rate(node_pressure_cpu_waiting_seconds_total[$__rate_interval]))",
          "legendFormat": "CPU: some waiting",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(rate(node_pressure_memory_waiting_seconds_total[$__rate_interval]))",
          "legendFormat": "memory: some waiting",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(rate(node_pressure_memory_stalled_seconds_total[$__rate_interval]))",
          "legendFormat": "memory: all stalled",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(rate(node_pressure_io_waiting_seconds_total[$__rate_interval]))",
          "legendFormat": "I/O: some waiting",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "expr": "max(rate(node_pressure_io_stalled_seconds_total[$__rate_interval]))",
          "legendFormat": "I/O: all stalled",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
