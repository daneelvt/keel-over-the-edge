# Written by the hardening role. update-grub reads it after the image's
# own settings, so it sees and changes them: no memory kept back for crash
# dumps (crashkernel=, which kdump-tools adds), and the kernel's audit and
# AppArmor on from the start.
GRUB_CMDLINE_LINUX_DEFAULT="$(echo "$GRUB_CMDLINE_LINUX_DEFAULT" | sed -E 's/(^| )crashkernel=[^ ]*//g')"
GRUB_CMDLINE_LINUX="$(echo "$GRUB_CMDLINE_LINUX" | sed -E 's/(^| )crashkernel=[^ ]*//g') {{ hardening_boot_args | join(' ') }}"
